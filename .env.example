# App A Backend URL (PHP VPS API Endpoint - Server-Only, never exposed to client browser)
API_BASE_URL=https://your-app-a-vps-domain.com/api

# Server Secret API Key (Never expose to browser, accessed server-side only in proxy route)
BPS_API_KEY=YOUR_SERVER_API_KEY

# Cryptographic HMAC-SHA256 Session Secret (Minimum 32 random characters)
SESSION_SECRET=your_unguessable_random_session_secret_min_32_characters

